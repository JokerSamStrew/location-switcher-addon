{
  "manifest_version": 3,
  "name": "Location Switcher",
  "version": "1.4.4",
  "description": "Switching between development and production sites.",
  "homepage_url": "https://github.com/ethanliu/location-switcher-addon",

  "content_security_policy": {
    "extension_pages": "default-src 'self'"
  },

  "icons": {
    "48": "icons/default.svg",
    "96": "icons/default.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "location-switcher-addon-plus@creativecrap.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "permissions": [
          {
            "name": "none",
            "description": "No personal data collected or transmitted by this extension"
          }
        ]
      }
    }
  },

  "permissions": ["tabs", "storage"],

  "page_action": {
    "default_icon": "icons/default.svg",
    "default_popup": "/popup/popup.html"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "background": {
    "scripts": ["background.js"]
  },

  "commands": {
    "_execute_page_action": {
      "description": "Trigger the default action"
    }
  }
}
